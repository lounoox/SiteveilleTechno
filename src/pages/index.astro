---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Cite from '../components/Cite.astro';
import SourceList from '../components/SourceList.astro';
import { SITE, SUBJECTS } from '../config';

const S = [
  'verisign-q2-2026',
  'dnib-q2-2026',
  'dnsbelgium-ar-2025',
  'dnsbelgium-home',
  'w3techs-https',
  'almanac-2025',
  'iana-root-servers',
  'rootservers-org',
];
---
<Base description="Site de veille Web de Louis Denis (IFOSUP) : la timeline du Web, les URL, les noms de domaine, les standards et la sécurité, expliqués avec des schémas et des éléments interactifs.">
  <section class="hero on-navy">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="kicker">Examen 5XENV · Veille Web · Octobre 2026</p>
        <h1>Le Web, de 1969 à votre écran</h1>
        <p class="hero__lead">
          Cinq sujets pour comprendre d’où vient le Web, comment on trouve une page, qui fixe les règles et comment s’y
          protéger. Pour suivre, un fil rouge : <strong>Le Cornet d’Or</strong>, une friterie inventée qui ouvre son site.
        </p>
        <div class="hero__cta">
          <a class="btn btn--gold" href={SUBJECTS[0].slug}>Commencer le parcours <span aria-hidden="true">→</span></a>
          <a class="btn btn--ghost hero__ghost" href="/sources/">Les sources</a>
        </div>
        <p class="hero__author">
          Un site de <strong>{SITE.author}</strong><br />
          {SITE.school} · {SITE.course}
        </p>
      </div>
      <div class="hero__art">
        <Logo animated label="Le logo du Cornet d’Or : un cornet de frites dont les frites forment un graphique en barres" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="parcours-titre">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Le parcours</p>
        <h2 id="parcours-titre">Cinq sujets, cinq étapes</h2>
        <p>Chaque page contient une explication avec des schémas, un élément interactif, un exemple avec la friterie et ses sources.</p>
      </div>
      <ol class="road">
        {
          SUBJECTS.map((s) => (
            <li class="road__item reveal">
              <a class="road__card" href={s.slug}>
                <span class="road__stop" aria-hidden="true">{s.n}</span>
                <span class="kicker">Sujet {s.n} · {s.theme}</span>
                <span class="road__title">{s.title}</span>
                <span class="road__q">{s.question}</span>
                <span class="road__teaser">{s.teaser}</span>
                <span class="road__go" aria-hidden="true">Lire <span>→</span></span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="chiffres">
    <div class="wrap">
      <div class="band reveal">
        <p class="kicker">Le Web en chiffres</p>
        <h2 id="chiffres">Quatre ordres de grandeur pour commencer</h2>
        <div class="stats">
          <div class="stat">
            <span class="stat__value">401,6 M</span>
            <span class="stat__label">noms de domaine dans le monde, fin juin 2026</span>
            <span class="stat__src">Sources<Cite list={S} ids={['verisign-q2-2026', 'dnib-q2-2026']} /></span>
          </div>
          <div class="stat">
            <span class="stat__value">1,7 M</span>
            <span class="stat__label">noms de domaine en .be, l’extension de la Belgique</span>
            <span class="stat__src">Sources<Cite list={S} ids={['dnsbelgium-ar-2025', 'dnsbelgium-home']} /></span>
          </div>
          <div class="stat">
            <span class="stat__value">9 sur 10</span>
            <span class="stat__label">sites qui s’ouvrent en HTTPS, la version chiffrée du Web</span>
            <span class="stat__src">Sources<Cite list={S} ids={['w3techs-https', 'almanac-2025']} /></span>
          </div>
          <div class="stat">
            <span class="stat__value">13</span>
            <span class="stat__label">serveurs racine, tout en haut de l’annuaire mondial du DNS</span>
            <span class="stat__src">Sources<Cite list={S} ids={['iana-root-servers', 'rootservers-org']} /></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fil-rouge">
    <div class="wrap fil">
      <div class="fil__logo">
        <Logo outline />
      </div>
      <div class="prose">
        <p class="kicker">Le fil rouge</p>
        <h2 id="fil-rouge">Pourquoi une friterie ?</h2>
        <p>
          Des exemples concrets se retiennent mieux que des définitions. Le Cornet d’Or, une friterie belge imaginaire, veut
          mettre sa carte en ligne. À chaque sujet, on suit une étape de son arrivée sur le Web : son adresse
          (<code>https://www.lecornetdor.be/menu/</code>), son nom de domaine, une page qui respecte les standards et un site
          sûr pour ses clients.
        </p>
        <p>
          Le logo, un cornet dont les frites dessinent un graphique, est le même que dans ma présentation orale.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fabrique">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Les coulisses</p>
        <h2 id="fabrique">Comment ce site est fabriqué</h2>
      </div>
      <div class="grid-cards">
        <article class="mini-card reveal">
          <p class="big" aria-hidden="true">SSG</p>
          <h3>Généré à l’avance</h3>
          <p>Le site est construit avec Astro, un générateur de site statique : toutes les pages sont fabriquées avant la mise en ligne sur Vercel.</p>
        </article>
        <article class="mini-card reveal">
          <p class="big" aria-hidden="true">A11Y</p>
          <h3>Accessible</h3>
          <p>Navigation complète au clavier, textes alternatifs, contrastes vérifiés, thème sombre, animations coupées si votre système le demande.</p>
        </article>
        <article class="mini-card reveal">
          <p class="big" aria-hidden="true">2×</p>
          <h3>Vérifié deux fois</h3>
          <p>Chaque date, chiffre ou nom renvoie, par un petit numéro, à au moins deux sources consultées en octobre 2026.</p>
        </article>
      </div>
      <p style="margin-top:1.5rem"><a href="/sources/#fabrication">En savoir plus sur la fabrication et les outils utilisés</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="sources-page">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Vérifié dans deux sources</p>
        <h2 id="sources-page">Les sources des chiffres de cette page</h2>
      </div>
      <SourceList list={S} />
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--navy);
    color: var(--on-navy);
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem);
    overflow: hidden;
    position: relative;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto -10% -40% 40%;
    height: 80%;
    background: radial-gradient(closest-side, rgb(61 95 230 / 0.35), transparent);
    pointer-events: none;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero__text {
    display: grid;
    gap: 1.3rem;
  }
  .hero h1 {
    color: var(--on-navy);
    font-size: clamp(2.8rem, 1.6rem + 5vw, 5.6rem);
    max-width: 12ch;
  }
  .hero__lead {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    color: var(--on-navy-muted);
    max-width: 52ch;
  }
  .hero__lead strong {
    color: var(--gold);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__ghost {
    color: var(--on-navy);
    border-color: var(--on-navy-muted);
  }
  .hero__author {
    color: var(--on-navy-muted);
    font-size: 0.98rem;
    border-left: 4px solid var(--gold);
    padding-left: 0.9rem;
  }
  .hero__author strong {
    color: var(--on-navy);
    font: 800 1.35rem/1.3 var(--font-display);
  }
  .hero__art {
    justify-self: center;
    width: min(100%, 420px);
  }
  .hero__art :global(svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
  }
  @media (max-width: 820px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__art {
      width: min(60%, 260px);
      grid-row: 1;
    }
  }

  /* La route des cinq sujets, comme la ligne du fil rouge dans le support oral */
  .road {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    position: relative;
  }
  .road::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 2rem;
    right: 2rem;
    height: 4px;
    border-radius: 4px;
    background: var(--ink);
  }
  .road__item {
    position: relative;
    padding-top: 0;
  }
  .road__card {
    position: relative;
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 4.4rem 1.2rem 1.4rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .road__card:hover,
  .road__card:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
    border-color: var(--ink);
  }
  .road__stop {
    position: absolute;
    top: 0;
    left: 1.2rem;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--card);
    border: 5px solid var(--ink);
    font: 700 1.3rem/1 var(--font-mono);
    transition: background-color 0.25s, transform 0.25s;
  }
  .road__card:hover .road__stop,
  .road__card:focus-visible .road__stop {
    background: var(--gold);
    color: #141b2d;
    transform: scale(1.08);
  }
  .road__title {
    font: 800 1.3rem/1.15 var(--font-display);
    letter-spacing: -0.015em;
  }
  .road__q {
    font-weight: 700;
    color: var(--blue);
  }
  .road__teaser {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .road__go {
    margin-top: auto;
    font-weight: 700;
    padding-top: 0.5rem;
  }
  .road__go span {
    display: inline-block;
    transition: transform 0.2s;
  }
  .road__card:hover .road__go span {
    transform: translateX(5px);
  }
  @media (max-width: 1100px) {
    .road {
      grid-template-columns: 1fr;
      padding-left: 1rem;
    }
    .road::before {
      top: 1rem;
      bottom: 1rem;
      left: calc(1rem + 27px);
      right: auto;
      width: 4px;
      height: auto;
    }
    .road__card {
      padding: 1.2rem 1.2rem 1.2rem 5.2rem;
      min-height: 0;
    }
    .road__stop {
      top: 1.1rem;
      left: 0.6rem;
    }
  }

  .fil {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
  }
  .fil__logo {
    width: clamp(110px, 8rem + 4vw, 200px);
  }
  @media (max-width: 640px) {
    .fil {
      grid-template-columns: 1fr;
    }
    .fil__logo {
      width: 110px;
    }
  }
</style>
