---
// Analyseur d'URL : utilise l'outil URL intégré au navigateur (le même que celui qui lit la barre d'adresse).
import Lab from '../Lab.astro';
import { resultHtml } from '../../lib/urlAnalyse';

const presets = [
  { label: 'La carte du Cornet d’Or', url: 'https://www.lecornetdor.be:443/menu/sauces?piquant=oui&taille=grand#andalouse' },
  { label: 'Le tout premier site Web', url: 'http://info.cern.ch/hypertext/WWW/TheProject.html' },
  { label: 'Une recherche', url: 'https://www.google.com/search?q=frites+belges&hl=fr' },
  { label: 'Des espaces et des accents', url: 'https://exemple.be/menu du jour/sauce?nom=andalouse épicée' },
  { label: 'Un site en développement', url: 'http://localhost:4321/timeline-du-web/' },
];
---
<Lab id="analyseur" title="L’analyseur d’URL">
  <div class="urllab" data-urllab>
    <form class="urllab__form" data-form>
      <label for="url-input" class="urllab__label">Collez ou tapez une adresse</label>
      <div class="urllab__row">
        <input
          id="url-input"
          type="text"
          inputmode="url"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          value={presets[0].url}
          data-input
        />
        <button class="btn btn--gold" type="submit">Analyser</button>
      </div>
    </form>

    <div class="urllab__presets">
      <p class="lab__hint" id="presets-label">Ou essayez un exemple :</p>
      <div class="chips" role="group" aria-labelledby="presets-label">
        {presets.map((p) => <button class="chip" type="button" data-preset={p.url}>{p.label}</button>)}
      </div>
    </div>

    <div class="urllab__result" data-result aria-live="polite" set:html={resultHtml(presets[0].url)} />
  </div>
</Lab>

<style>
  .urllab {
    display: grid;
    gap: 1.25rem;
  }
  .urllab__label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .urllab__row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .urllab__row input {
    flex: 1 1 260px;
    min-width: 0;
    min-height: 52px;
    padding: 0.6rem 1rem;
    border-radius: 14px;
    border: 2px solid var(--line);
    background: var(--paper);
    font: 500 1rem/1.4 var(--font-mono);
  }
  .urllab__row input:focus {
    border-color: var(--ink);
    outline: none;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .urllab__presets {
    display: grid;
    gap: 0.5rem;
  }
  .urllab__result {
    display: grid;
    gap: 1rem;
  }
  :global(.urllab__big) {
    font: 500 clamp(1rem, 0.85rem + 0.7vw, 1.35rem) / 1.9 var(--font-mono);
    padding: 1rem 1.2rem;
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  :global(.urllab__big .seg) {
    padding: 0.15rem 0.3rem;
    margin-right: 1px;
    position: relative;
  }
  :global(.urllab__big .seg sup) {
    font: 700 0.6em/1 var(--font-mono);
    margin-left: 0.15em;
    opacity: 0.85;
  }
  :global(.urllab__note) {
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: var(--gold-tint);
    color: var(--gold-text);
    font-weight: 700;
  }
  :global(.urllab__error) {
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: var(--danger-tint);
    border: 2px solid var(--danger);
  }
  :global(.urllab__parts) {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.75rem;
  }
  :global(.urllab__parts > li) {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  :global(.urllab__parts > li.is-absent) {
    opacity: 0.75;
    border-style: dashed;
  }
  :global(.urllab__parts .name) {
    font: 700 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  :global(.urllab__parts .val) {
    justify-self: start;
    padding: 0.15rem 0.45rem;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  :global(.urllab__parts .what) {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.45;
  }
  :global(.urllab__params) {
    list-style: none;
    padding: 0.5rem 0 0;
    border-top: 1px dashed var(--line);
    display: grid;
    gap: 0.2rem;
    font: 500 0.88rem/1.4 var(--font-mono);
    overflow-wrap: anywhere;
  }
  :global(.urllab__request) {
    background: var(--navy);
    color: var(--on-navy);
    border-radius: 16px;
    padding: 1rem 1.2rem;
    display: grid;
    gap: 0.5rem;
  }
  :global(.urllab__request pre) {
    font: 500 0.92rem/1.6 var(--font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--on-navy);
  }
  :global(.urllab__request .kicker) {
    color: var(--gold);
  }
  :global(.urllab__request p) {
    color: var(--on-navy-muted);
    font-size: 0.95rem;
  }
  :global(.urllab__request strong) {
    color: var(--gold);
  }
</style>

<script>
  import { resultHtml } from '../../lib/urlAnalyse';

  document.querySelectorAll<HTMLElement>('[data-urllab]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const out = root.querySelector<HTMLElement>('[data-result]')!;
    const render = () => (out.innerHTML = resultHtml(input.value));
    root.querySelector('[data-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      render();
    });
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.preset!;
        render();
      })
    );
  });
</script>
