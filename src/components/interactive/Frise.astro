---
// Frise chronologique interactive : filtres par thème, défilement au clavier,
// axe des années cliquable. Sans JavaScript, la frise reste une liste lisible.
import Cite from '../Cite.astro';
import Lab from '../Lab.astro';
import { EVENTS, CATEGORIES, type Category } from '../../data/timeline';

interface Props {
  list: string[];
}
const { list } = Astro.props;
const cats = Object.entries(CATEGORIES) as [Category, string][];
const MIN = 1966;
const MAX = 2029;
const pos = (y: number) => ((y - MIN) / (MAX - MIN)) * 100;
// Décale verticalement les dates de la même année pour qu'elles ne se chevauchent pas.
const seen: Record<number, number> = {};
const ticks = EVENTS.map((e) => {
  const lane = (seen[e.year] = (seen[e.year] ?? -1) + 1);
  return { ...e, left: pos(e.year), lane };
});
const decades = [1970, 1980, 1990, 2000, 2010, 2020];
---
<Lab id="frise" title="La frise du Web, de 1969 à 2026">
  <div class="frise" data-frise>
    <div class="frise__controls">
      <div class="chips" role="group" aria-label="Filtrer la frise par thème">
        <button class="chip" type="button" aria-pressed="true" data-filter="all">Tout <span class="count">({EVENTS.length})</span></button>
        {
          cats.map(([key, label]) => (
            <button class="chip" type="button" aria-pressed="false" data-filter={key}>
              <span class={`dot dot--${key}`} aria-hidden="true" />
              {label} <span class="count">({EVENTS.filter((e) => e.cat === key).length})</span>
            </button>
          ))
        }
      </div>
      <div class="frise__nav">
        <button class="icon-btn" type="button" data-scroll="-1">
          <span class="visually-hidden">Date précédente</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="icon-btn" type="button" data-scroll="1">
          <span class="visually-hidden">Date suivante</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div class="frise__axis" aria-hidden="true">
      <div class="frise__rail"></div>
      {decades.map((d) => <span class="frise__decade" style={`left:${pos(d)}%`}>{d}</span>)}
      {
        ticks.map((t) => (
          <button
            type="button"
            tabindex="-1"
            class={`frise__tick dot--${t.cat}`}
            style={`left:${t.left}%;--lane:${t.lane}`}
            data-goto={t.id}
            title={`${t.date} : ${t.title}`}
          />
        ))
      }
    </div>

    <p class="visually-hidden" id="frise-help">
      Liste de seize dates. Sur ordinateur, utilisez les flèches gauche et droite pour passer d’une date à l’autre.
    </p>
    <ol class="frise__track" tabindex="0" aria-describedby="frise-help" aria-label="Seize dates de l'histoire d'Internet et du Web">
      {
        EVENTS.map((e) => (
          <li class="frise__item" id={`date-${e.id}`} data-cat={e.cat}>
            <div class="frise__pin" aria-hidden="true">
              <span class={`frise__bullet dot--${e.cat}`} />
            </div>
            <article class="frise__card">
              <p class="frise__year" aria-hidden="true">{e.year}</p>
              <p class="frise__date">
                <time datetime={e.iso}>{e.date}</time>
                <span class={`frise__cat cat--${e.cat}`}>{CATEGORIES[e.cat]}</span>
              </p>
              <h4>{e.title}</h4>
              <p class="frise__text">
                {e.text}
                <Cite list={list} ids={e.sources} />
              </p>
            </article>
          </li>
        ))
      }
    </ol>
    <p class="lab__hint frise__status" aria-live="polite" data-status></p>
  </div>
</Lab>

<style>
  .frise {
    display: grid;
    gap: 1.25rem;
  }
  .frise__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .frise__nav {
    display: flex;
    gap: 0.5rem;
  }
  .count {
    font-weight: 400;
    opacity: 0.75;
  }
  .dot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    margin-right: 0.35rem;
    vertical-align: 0.05em;
  }
  .dot--internet {
    background: #2747c9;
  }
  .dot--web {
    background: #f4b400;
  }
  .dot--standards {
    background: #141b2d;
    box-shadow: inset 0 0 0 2px #aeb8ce;
  }
  .dot--societe {
    background: #6f86e0;
  }

  /* Axe des années */
  .frise__axis {
    position: relative;
    height: 74px;
    margin: 0 0.5rem;
  }
  .frise__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    height: 3px;
    background: var(--line);
    border-radius: 3px;
  }
  .frise__decade {
    position: absolute;
    top: 44px;
    transform: translateX(-50%);
    font: 700 0.78rem/1 var(--font-mono);
    color: var(--muted);
  }
  .frise__decade::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -22px;
    width: 2px;
    height: 12px;
    background: var(--faint);
  }
  .frise__tick {
    position: absolute;
    top: calc(14px - var(--lane) * 14px);
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    border: 3px solid var(--card);
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s, opacity 0.3s;
  }
  .frise__tick:hover,
  .frise__tick.is-active {
    transform: scale(1.35);
    box-shadow: 0 0 0 3px var(--gold);
  }
  .frise__tick.is-out {
    opacity: 0.15;
  }

  /* Piste des cartes */
  .frise__track {
    list-style: none;
    padding: 0.5rem 0.25rem 1.25rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(270px, 320px);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--faint) transparent;
  }
  .frise__item {
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.6rem;
  }
  .frise__item[hidden] {
    display: none;
  }
  .frise__pin {
    position: relative;
    height: 22px;
  }
  .frise__pin::before {
    content: '';
    position: absolute;
    left: -0.5rem;
    right: -0.5rem;
    top: 10px;
    height: 3px;
    background: var(--ink);
    opacity: 0.85;
  }
  .frise__bullet {
    position: absolute;
    left: 1.2rem;
    top: 1px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 4px solid var(--ink);
  }
  .frise__card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem 1.3rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .frise__item.is-active .frise__card {
    border-color: var(--ink);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .frise__year {
    font: 800 2.8rem/1 var(--font-display);
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .frise__date {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font: 700 0.78rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .frise__cat {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  .cat--internet {
    background: var(--blue-tint);
    color: var(--blue-deep);
  }
  .cat--web {
    background: var(--gold-tint);
    color: var(--gold-text);
  }
  .cat--standards {
    background: var(--ink);
    color: var(--paper);
  }
  .cat--societe {
    background: var(--paper-2);
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .frise__card h4 {
    font: 800 1.25rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .frise__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Sur téléphone : frise verticale, sans défilement horizontal */
  @media (max-width: 720px) {
    .frise__axis,
    .frise__nav {
      display: none;
    }
    .frise__track {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      overflow: visible;
      padding: 0 0 0 1.75rem;
      position: relative;
      gap: 1.25rem;
    }
    .frise__track::before {
      content: '';
      position: absolute;
      left: 0.55rem;
      top: 0.5rem;
      bottom: 0.5rem;
      width: 3px;
      background: var(--ink);
      border-radius: 3px;
    }
    .frise__item {
      grid-template-rows: auto;
      position: relative;
    }
    .frise__pin {
      position: absolute;
      left: -1.75rem;
      top: 1.2rem;
      height: auto;
    }
    .frise__pin::before {
      display: none;
    }
    .frise__bullet {
      left: 0;
      top: 0;
    }
    .frise__year {
      font-size: 2.2rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-frise]').forEach((root) => {
    const track = root.querySelector<HTMLOListElement>('.frise__track')!;
    const items = [...root.querySelectorAll<HTMLLIElement>('.frise__item')];
    const ticks = [...root.querySelectorAll<HTMLButtonElement>('.frise__tick')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const visible = () => items.filter((i) => !i.hidden);

    const setActive = (item: HTMLLIElement | undefined) => {
      items.forEach((i) => i.classList.toggle('is-active', i === item));
      ticks.forEach((t) => t.classList.toggle('is-active', !!item && t.dataset.goto === item.id.replace('date-', '')));
    };

    const scrollToItem = (item: HTMLLIElement) => {
      const left = item.offsetLeft - track.offsetLeft - 4;
      track.scrollTo({ left, behavior: reduce ? 'auto' : 'smooth' });
      setActive(item);
    };

    // Carte active = première carte visible dans la piste
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const x = track.scrollLeft + 10;
        const current = visible().find((i) => i.offsetLeft - track.offsetLeft + i.offsetWidth > x);
        setActive(current);
      });
    });

    const step = (dir: number) => {
      const list = visible();
      const current = list.findIndex((i) => i.classList.contains('is-active'));
      const next = list[Math.max(0, Math.min(list.length - 1, (current < 0 ? 0 : current) + dir))];
      if (next) scrollToItem(next);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.scroll)))
    );
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        scrollToItem(visible()[0]);
      } else if (e.key === 'End') {
        e.preventDefault();
        scrollToItem(visible()[visible().length - 1]);
      }
    });

    ticks.forEach((t) =>
      t.addEventListener('click', () => {
        const item = root.querySelector<HTMLLIElement>(`#date-${t.dataset.goto}`);
        if (!item) return;
        if (item.hidden) applyFilter('all');
        scrollToItem(item);
      })
    );

    const applyFilter = (key: string) => {
      filters.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.filter === key)));
      items.forEach((i) => (i.hidden = key !== 'all' && i.dataset.cat !== key));
      ticks.forEach((t) => {
        const item = root.querySelector<HTMLLIElement>(`#date-${t.dataset.goto}`);
        t.classList.toggle('is-out', !!item?.hidden);
      });
      track.scrollTo({ left: 0 });
      const n = visible().length;
      const label = filters.find((f) => f.dataset.filter === key)?.textContent?.replace(/\(\d+\)/, '').trim();
      status.textContent = key === 'all' ? `Les ${n} dates sont affichées.` : `${n} dates affichées pour le thème « ${label} ».`;
      setActive(visible()[0]);
    };
    filters.forEach((f) => f.addEventListener('click', () => applyFilter(f.dataset.filter!)));

    setActive(items[0]);
  });
</script>
