---
// Les trois couches du Web sur une vraie mini-page : HTML seul, puis + CSS, puis + JavaScript.
import Lab from '../Lab.astro';

const items = [
  { name: 'Cornet de frites (moyen)', price: 3.8 },
  { name: 'Fricadelle', price: 3.2 },
  { name: 'Sauce andalouse', price: 1 },
];
const euro = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
---
<Lab id="couches" title="Allumez les trois couches, une par une">
  <div class="couches" data-couches>
    <fieldset class="couches__switch">
      <legend class="visually-hidden">Couches actives</legend>
      <label><input type="radio" name="couche" value="html" checked /><span><b>1</b> HTML seul</span></label>
      <label><input type="radio" name="couche" value="css" /><span><b>2</b> + CSS</span></label>
      <label><input type="radio" name="couche" value="js" /><span><b>3</b> + JavaScript</span></label>
    </fieldset>

    <div class="couches__grid">
      <div class="browser">
        <div class="browser__bar" aria-hidden="true">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="browser__url">lecornetdor.be/menu/</span>
        </div>
        <div class="demo mode-html" data-demo>
          <div class="demo__card">
            <h4 class="demo__title">Le Cornet d’Or</h4>
            <p class="demo__sub">Friterie · La carte du jour (prix fictifs)</p>
            <ul class="demo__list">
              {
                items.map((it) => (
                  <li>
                    <span class="demo__name">{it.name}</span><span class="demo__sep"> — </span><span class="demo__price">{euro(it.price)}</span>{' '}<button type="button" class="demo__add" data-price={it.price} data-name={it.name}>
                      Ajouter<span class="visually-hidden"> : {it.name}</span>
                    </button>
                  </li>
                ))
              }
            </ul>
            <p class="demo__total">Ma commande : <output data-total>0 article · 0,00 €</output></p>
            <button type="button" class="demo__order" data-order>Commander</button>
            <p class="demo__msg" data-msg aria-live="polite"></p>
          </div>
        </div>
      </div>

      <div class="couches__explain">
        <div class="couches__panel" data-panel="html">
          <p class="kicker">Couche 1 · HTML · la structure</p>
          <p>Le contenu est là : un titre, une liste, des prix, des boutons. Mais tout a l’apparence par défaut du navigateur, et les boutons ne font rien.</p>
          <pre><code>&lt;h1&gt;Le Cornet d’Or&lt;/h1&gt;
&lt;ul&gt;
  &lt;li&gt;Fricadelle 3,20 €
    &lt;button&gt;Ajouter&lt;/button&gt;
  &lt;/li&gt;
&lt;/ul&gt;</code></pre>
        </div>
        <div class="couches__panel" data-panel="css" hidden>
          <p class="kicker">Couche 2 · CSS · l’apparence</p>
          <p>Le CSS ajoute les couleurs, la police, les marges, la mise en page. Le texte est exactement le même. Les boutons sont jolis… mais toujours inactifs.</p>
          <pre><code>.carte {'{'}
  background: #141B2D;
  border-radius: 20px;
{'}'}
.prix {'{'} color: #F4B400; {'}'}</code></pre>
        </div>
        <div class="couches__panel" data-panel="js" hidden>
          <p class="kicker">Couche 3 · JavaScript · le comportement</p>
          <p>JavaScript réagit aux clics : il ajoute les articles et calcule le total. Essayez les boutons « Ajouter » puis « Commander ».</p>
          <pre><code>bouton.addEventListener('click', () =&gt; {'{'}
  total = total + prix;
  affichage.textContent = total + ' €';
{'}'});</code></pre>
        </div>
        <p class="lab__hint" data-hint aria-live="polite"></p>
      </div>
    </div>
  </div>
</Lab>

<style>
  .couches {
    display: grid;
    gap: 1.25rem;
  }
  .couches__switch {
    border: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .couches__switch label {
    position: relative;
  }
  .couches__switch input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .couches__switch span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 2px solid var(--line);
    background: var(--card);
    font-weight: 700;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .couches__switch b {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid currentColor;
    font: 700 0.8rem/1 var(--font-mono);
  }
  .couches__switch input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .couches__switch input:checked + span b {
    background: var(--gold);
    border-color: var(--gold);
    color: #141b2d;
  }
  .couches__switch input:focus-visible + span {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .couches__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .couches__grid {
      grid-template-columns: 1fr;
    }
  }
  .couches__explain {
    display: grid;
    gap: 0.75rem;
  }
  .couches__panel {
    display: grid;
    gap: 0.6rem;
  }
  .couches__panel[hidden] {
    display: none;
  }
  .couches__panel pre {
    background: var(--navy-2);
    color: var(--on-navy);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font: 500 0.9rem/1.6 var(--font-mono);
  }

  /* La mini-page */
  .demo {
    min-height: 380px;
    padding: 1.25rem;
    background: #ffffff;
    color: #000000;
  }
  /* Couche 1 : on annule tous les styles du site pour retrouver ceux du navigateur */
  .demo.mode-html,
  .demo.mode-html :global(*) {
    all: revert;
  }
  .demo.mode-html {
    display: block;
    padding: 0.5rem 1rem;
    background: #ffffff;
    color: #000000;
    font-family: 'Times New Roman', Times, serif;
  }
  .demo.mode-html .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .demo.mode-html .demo__title {
    font-size: 2em;
    margin: 0.67em 0;
  }

  /* Couches 2 et 3 : la carte stylée dans la DA du site */
  .demo.mode-css,
  .demo.mode-js {
    background: var(--paper);
    display: grid;
    place-items: center;
  }
  .mode-css .demo__card,
  .mode-js .demo__card {
    width: min(100%, 420px);
    background: #141b2d;
    color: #eef1f7;
    border-radius: 20px;
    padding: 1.5rem;
    display: grid;
    gap: 0.75rem;
    box-shadow: var(--shadow-lift);
    font-family: var(--font-body);
    animation: pop 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  @keyframes pop {
    from {
      transform: scale(0.94);
      opacity: 0.4;
    }
  }
  .mode-css .demo__title,
  .mode-js .demo__title {
    font: 800 1.7rem/1.1 var(--font-display);
    color: #eef1f7;
    letter-spacing: -0.02em;
  }
  .mode-css .demo__sub,
  .mode-js .demo__sub {
    font: 700 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f4b400;
  }
  .mode-css .demo__list,
  .mode-js .demo__list {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .mode-css .demo__list li,
  .mode-js .demo__list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 2px dotted #4a5878;
  }
  .mode-css .demo__sep,
  .mode-js .demo__sep {
    display: none;
  }
  .mode-css .demo__price,
  .mode-js .demo__price {
    white-space: nowrap;
    font-weight: 700;
    color: #f4b400;
    font-variant-numeric: tabular-nums;
  }
  .mode-css .demo__add,
  .mode-js .demo__add,
  .mode-css .demo__order,
  .mode-js .demo__order {
    min-height: 40px;
    border: 0;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    background: #f4b400;
    color: #141b2d;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .mode-css .demo__order,
  .mode-js .demo__order {
    justify-self: start;
    min-height: 46px;
    padding: 0.5rem 1.4rem;
    font-size: 1rem;
    background: #3d5fe6;
    color: #ffffff;
  }
  .mode-css .demo__total,
  .mode-js .demo__total {
    color: #aeb8ce;
  }
  .mode-css .demo__total output,
  .mode-js .demo__total output {
    color: #eef1f7;
    font-weight: 700;
  }
  .mode-js .demo__msg:not(:empty) {
    background: #f4b400;
    color: #141b2d;
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    font-weight: 700;
  }
  .mode-js .demo__add:active {
    transform: scale(0.94);
  }
  @media (max-width: 480px) {
    .demo.mode-css,
    .demo.mode-js {
      padding: 0.6rem;
    }
    .mode-css .demo__card,
    .mode-js .demo__card {
      padding: 1.1rem;
    }
    .mode-css .demo__list li,
    .mode-js .demo__list li {
      gap: 0.5rem;
    }
    .mode-css .demo__add,
    .mode-js .demo__add {
      padding: 0.3rem 0.75rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-couches]').forEach((root) => {
    const demo = root.querySelector<HTMLElement>('[data-demo]')!;
    const totalOut = root.querySelector<HTMLOutputElement>('[data-total]')!;
    const msg = root.querySelector<HTMLElement>('[data-msg]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    let mode = 'html';
    let count = 0;
    let total = 0;
    const euro = (n: number) => n.toFixed(2).replace('.', ',') + ' €';
    const refresh = () => (totalOut.textContent = `${count} article${count > 1 ? 's' : ''} · ${euro(total)}`);

    root.querySelectorAll<HTMLInputElement>('input[name="couche"]').forEach((r) =>
      r.addEventListener('change', () => {
        mode = r.value;
        demo.className = `demo mode-${mode}`;
        panels.forEach((p) => (p.hidden = p.dataset.panel !== mode));
        hint.textContent = '';
        msg.textContent = '';
        if (mode !== 'js') {
          count = 0;
          total = 0;
          refresh();
        }
      })
    );

    root.querySelectorAll<HTMLButtonElement>('.demo__add').forEach((b) =>
      b.addEventListener('click', () => {
        if (mode !== 'js') {
          hint.textContent = 'Il ne se passe rien : sans la couche JavaScript, un bouton ne sait pas quoi faire. Activez la couche 3.';
          return;
        }
        count++;
        total += Number(b.dataset.price);
        refresh();
        msg.textContent = `${b.dataset.name} ajouté !`;
      })
    );

    root.querySelector<HTMLButtonElement>('[data-order]')!.addEventListener('click', () => {
      if (mode !== 'js') {
        hint.textContent = 'Toujours rien : c’est JavaScript qui donne un comportement aux boutons.';
        return;
      }
      msg.textContent = count
        ? `Commande envoyée : ${count} article${count > 1 ? 's' : ''} pour ${euro(total)}. Bon appétit !`
        : 'Votre commande est vide : ajoutez d’abord un article.';
      if (count) {
        count = 0;
        total = 0;
        refresh();
      }
    });
  });
</script>
