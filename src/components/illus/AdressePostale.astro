---
// Schéma : une URL se lit comme une adresse postale, du plus général au plus précis.
const rows = [
  { part: 'Schéma', poste: 'Comment livrer ?', ex: 'En recommandé, par la poste', url: 'https://', cls: 'scheme' },
  { part: 'Domaine', poste: 'Quel bâtiment ?', ex: 'La friterie Le Cornet d’Or', url: 'www.lecornetdor.be', cls: 'host' },
  { part: 'Port', poste: 'Quelle porte ?', ex: 'L’entrée des livraisons', url: ':443', cls: 'port' },
  { part: 'Chemin', poste: 'Quelle pièce ?', ex: 'Le comptoir, rayon sauces', url: '/menu/sauces', cls: 'path' },
  { part: 'Paramètres', poste: 'Quelles précisions ?', ex: 'Piquante, grand format', url: '?piquant=oui&taille=grand', cls: 'query' },
  { part: 'Ancre', poste: 'Où exactement ?', ex: 'Le pot d’andalouse', url: '#andalouse', cls: 'hash' },
];
---
<div class="postal" role="group" aria-labelledby="postal-title">
  <p class="postal__title" id="postal-title">Une URL se lit comme une adresse postale</p>
  <ol class="postal__rows">
    {
      rows.map((r, i) => (
        <li class="postal__row">
          <span class="postal__n" aria-hidden="true">{i + 1}</span>
          <span class="postal__poste">
            <strong>{r.poste}</strong>
            <span>{r.ex}</span>
          </span>
          <span class="postal__arrow" aria-hidden="true">→</span>
          <span class="postal__url">
            <code class={`seg seg--${r.cls}`}>{r.url}</code>
            <span class="postal__part">{r.part}</span>
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .postal {
    display: grid;
    gap: 1rem;
  }
  .postal__title {
    font: 700 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .postal__rows {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .postal__row {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .postal__n {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font: 700 0.8rem/1 var(--font-mono);
  }
  .postal__poste {
    display: grid;
    line-height: 1.3;
    font-size: 0.95rem;
  }
  .postal__poste span {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .postal__arrow {
    color: var(--faint);
    font-weight: 700;
  }
  .postal__url {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
  }
  .postal__part {
    font: 700 0.68rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .postal code.seg {
    border: 0;
    font-size: 0.85rem;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 520px) {
    .postal__row {
      grid-template-columns: 1.8rem minmax(0, 1fr);
    }
    .postal__arrow {
      display: none;
    }
    .postal__url {
      grid-column: 2;
    }
  }
</style>
