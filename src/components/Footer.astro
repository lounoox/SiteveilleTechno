---
import Logo from './Logo.astro';
import { SITE, SUBJECTS } from '../config';
---
<footer class="site-footer on-navy">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo />
        <div>
          <strong>{SITE.name}</strong>
          <p>Site de veille réalisé par <span lang="fr">{SITE.author}</span>, {SITE.school}, {SITE.course}, {SITE.year}.</p>
          <p>Le Cornet d’Or est une friterie inventée pour les exemples.</p>
        </div>
      </div>
      <div>
        <h2>Les sujets</h2>
        <ul>
          {SUBJECTS.map((s) => <li><a href={s.slug}>{s.n}. {s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Le site</h2>
        <ul>
          <li><a href="/sources/">Sources et outils utilisés</a></li>
          <li><a href="/sources/#accessibilite">Accessibilité du site</a></li>
          <li><a href="/sources/#fabrication">Comment ce site est fabriqué</a></li>
          {SITE.repoUrl && <li><a href={SITE.repoUrl}>Code source sur GitHub</a></li>}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Généré par Astro (un SSG) et hébergé sur Vercel.</p>
      <p>Informations vérifiées le {SITE.consulted}.</p>
    </div>
  </div>
</footer>
